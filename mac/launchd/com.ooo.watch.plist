<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ooo.watch</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__OOO_DIR__/watch.sh</string></array>
  <key>StartInterval</key><integer>10</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/ooo-watch.log</string>
  <key>StandardErrorPath</key><string>/tmp/ooo-watch.log</string>
</dict>
</plist>
